/*
 * Nextflow Configuration File
 * Supports local execution and Docker/Podman containerization
 */

manifest {
    name = 'hello-world-pipeline'
    author = 'test_repo'
    description = 'Simple Hello World Nextflow pipeline'
    version = '1.0.0'
}

/*
 * Default profile - runs locally without containers
 */
profiles {
    standard {
        process.executor = 'local'
    }

    /*
     * Docker profile using Podman
     * To use: nextflow run main.nf -profile docker
     */
    docker {
        docker.enabled = true
        docker.runOptions = '--runtime=podman'
        process.container = 'ubuntu:latest'
        
        // Use Podman instead of Docker
        docker.podman = true
    }
}

/*
 * Default process settings
 */
process {
    executor = 'local'
    cpus = 1
    memory = '1 GB'
}

/*
 * Execution report options
 */
report {
    enabled = true
    file = 'report.html'
}

timeline {
    enabled = true
    file = 'timeline.html'
}

trace {
    enabled = true
    file = 'trace.txt'
}
